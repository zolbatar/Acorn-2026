REM Alpha window task: Wimp events continue through Wimp_Poll.
REM Mode 20 is 640x512 with 80x64 text cells; its pixels map 1:1 to the hosted desktop.
MODE 20
DIM description% 24
$description%="Alpha task"
SYS "Wimp_Initialise",310,&4B534154,description%,0 TO version%,task%
DIM definition% 87
REM &BF000002: RISC OS 3 Back, Close, title, Toggle Size, scroll and resize.
REM BASIC integer stores that word as &3F000002-2147483648.
!definition%+28=&3F000002-2147483648
!definition%+56=1
title%=definition%+72
$title%="Alpha App"
!definition%=72:!definition%+4=280:!definition%+8=872:!definition%+12=840
!definition%+16=0:!definition%+20=0
!definition%+40=0:!definition%+44=-1024:!definition%+48=840:!definition%+52=0
!definition%+60=&3000:!definition%+68=0:!definition%+84=0
SYS "Wimp_CreateWindow",,definition% TO window%
DIM open% 31
!open%=window%:!open%+4=72:!open%+8=280:!open%+12=872:!open%+16=840
!open%+20=0:!open%+24=0:!open%+28=-1
SYS "Wimp_OpenWindow",,open%
DIM event% 255
clicks%=0
last_buttons%=0
last_key%=0
REPEAT
  SYS "Wimp_Poll",1,event% TO reason%
  IF reason%=1 THEN
    SYS "Wimp_RedrawWindow",,event% TO redraw%
    IF redraw% THEN
      REPEAT
        VDU 12:VDU 30
        PRINT "Alpha window"
        PRINT "Select or Adjust a control."
        PRINT "Menu in the work area."
        PRINT "Mouse clicks: ";clicks%
        PRINT "Buttons: ";last_buttons%
        PRINT "Key code: ";last_key%
        SYS "Wimp_GetRectangle",,event% TO redraw%
      UNTIL redraw%=0
    ENDIF
  ENDIF
  IF reason%=2 THEN SYS "Wimp_OpenWindow",,event%
  IF reason%=3 THEN
    SYS "Wimp_CloseWindow",,event%
    SYS "Wimp_CloseDown",task%,&4B534154
    END
  ENDIF
  IF reason%=6 THEN
    clicks%+=1
    last_buttons%=!(event%+8)
    SYS "Wimp_ForceRedraw",window%,0,-1024,840,0
  ENDIF
  IF reason%=8 THEN
    last_key%=!(event%+24)
    SYS "Wimp_ForceRedraw",window%,0,-1024,840,0
  ENDIF
UNTIL FALSE
