REM @BASIC64 MODE=BASIC64
REM @SYSTEM_PROFILE 0.1
REM @MODULE Error 1.0.0
REM @CAPABILITY ErrorDispatch
REM @IMPORT Host.Error.RaiseErrorBlock ErrorDispatch
REM @SWI OS_GenerateError &2B GenerateError REGISTERS=R0:ADDRESS32:IN;MEMORY=R0:READ:256;BLOCKING=FALSE;REENTRANT=TRUE;ERROR=OSError

DEF PROC GenerateError
    PRIMITIVE Host.Error.RaiseErrorBlock, R0%
ENDPROC
