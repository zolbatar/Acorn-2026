REM @BASIC64 MODE=BASIC64
REM @SYSTEM_PROFILE 0.1
REM @MODULE ColourTrans 1.0.0
REM @CAPABILITY GraphicsRaster
REM @EXPORT PROC COLOURTRANS_CONVERTHSVTORGB
REM @EXPORT PROC COLOURTRANS_SETGCOL
REM @EXPORT PROC COLOURTRANS_WRITEPALETTE
REM @IMPORT Host.Graphics.SetPackedRgb GraphicsRaster

DEF PROC COLOURTRANS_CONVERTHSVTORGB
    HUE = R0% / 65536
    HUE = HUE - 360 * INT(HUE / 360)
    IF HUE < 0 THEN HUE = HUE + 360
    SATURATION = R1% / 65280
    IF SATURATION > 1 THEN SATURATION = 1
    VCOMP = (R2% AND &FF) / 255
    CHROMA = VCOMP * SATURATION
    SECTOR = HUE / 60
    SECTORINDEX% = INT(SECTOR)
    SECONDARY = CHROMA * (1 - ABS(SECTOR - 2 * INT(SECTOR / 2) - 1))
    RED = 0
    GREEN = 0
    BLUE = 0
    IF SECTORINDEX% = 0 THEN RED = CHROMA: GREEN = SECONDARY
    IF SECTORINDEX% = 1 THEN RED = SECONDARY: GREEN = CHROMA
    IF SECTORINDEX% = 2 THEN GREEN = CHROMA: BLUE = SECONDARY
    IF SECTORINDEX% = 3 THEN GREEN = SECONDARY: BLUE = CHROMA
    IF SECTORINDEX% = 4 THEN RED = SECONDARY: BLUE = CHROMA
    IF SECTORINDEX% >= 5 THEN RED = CHROMA: BLUE = SECONDARY
    MATCHVALUE = VCOMP - CHROMA
    R0% = INT((RED + MATCHVALUE) * 255 + 0.5)
    R1% = INT((GREEN + MATCHVALUE) * 255 + 0.5)
    R2% = INT((BLUE + MATCHVALUE) * 255 + 0.5)
ENDPROC

DEF PROC COLOURTRANS_SETGCOL
    PRIMITIVE Host.Graphics.SetPackedRgb, R0%
ENDPROC

REM Hosted compatibility shim: indexed palettes are not mutable yet.
DEF PROC COLOURTRANS_WRITEPALETTE
ENDPROC
